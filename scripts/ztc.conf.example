# Copie para ~/ztc-backup/ztc.conf e ajuste.

# Off-site (WireGuard — IP da VM na rede wg)
ZTC_REMOTE="ztc-bkp@10.66.66.1:/var/backups/ztc/incoming/"
ZTC_SSH_KEY="$HOME/.ssh/ztc-bkp-ed25519"

# Blobs locais
ZTC_VAULT_HC="/caminho/seguro/vault.hc"
ZTC_MANIFEST_DIR="$HOME/ztc-backup/manifest"

# NFC opcional (saída de nfc-list; deixe vazio para desativar checagem)
ZTC_NFC_UID=""

# COMANDO 5.3 — mount condicional
ZTC_MOUNT_POINT="/media/veracrypt-ztc"
ZTC_KDBX="/media/veracrypt-ztc/lab-passwords.kdbx"
ZTC_KEYFILE="$HOME/keepass-keyfile.ztc"

# ============================================================
# VeraCrypt — camadas opcionais (habilitar/desabilitar)
# ============================================================
# Defaults abaixo: TODAS DESLIGADAS — VeraCrypt pede SO a senha.
# Para ativar uma camada, troque o valor da variavel (e descomente
# o exemplo se quiser referencia). Tudo funciona em conjunto.

# --- Camada 1: PIM (Personal Iterations Multiplier) ---
# Aumenta o trabalho de forca bruta multiplicando as iteracoes de
# derivacao da chave. Voce precisa lembrar o numero exato em cada
# mount — perdeu o PIM, perdeu o cofre.
# Valores tipicos: 485 (recomendado quando ativo), ate 999999.
ZTC_VC_PIM="0"                          # 0 = desligado (default)
# ZTC_VC_PIM="485"                      # exemplo: PIM ativo

# --- Camada 2: Keyfile do VeraCrypt ---
# Arquivo extra exigido no mount (separado do keyfile do KeePass!).
# Sem esse arquivo, o cofre nao abre mesmo com a senha correta.
# Multiplos keyfiles: separe por virgula.
ZTC_VC_KEYFILES=""                      # vazio = desligado (default)
# ZTC_VC_KEYFILES="$HOME/.ztc-vc-keyfile"
# ZTC_VC_KEYFILES="$HOME/key1.bin,$HOME/key2.bin"

# --- Camada 3: Volume Oculto (plausible deniability) ---
# Permite ter um volume "isca" visivel + um volume real escondido
# dentro do espaco livre. Util para casos de coacao fisica.
# Setup avancado — veja docs/APOSTILA-GUIA-PRATICO.md antes.
ZTC_VC_PROTECT_HIDDEN="no"              # no = desligado (default)
# ZTC_VC_PROTECT_HIDDEN="yes"           # exemplo: protege hidden no mount

# ============================================================
# Snapshot local do vault.hc (Camada 1 de backup)
# ============================================================
# Apos fechar o cofre, o ztc-close-cofre.sh chama o ztc-snapshot-vault.sh
# que copia o vault.hc para uma pasta versionada com sha256 + rotacao.
# Protege contra: corrupcao do arquivo, deleção acidental, ransomware
# (parcial — fica no mesmo disco). Para off-site veja Playbook 09.

ZTC_AUTO_SNAPSHOT="yes"                          # yes/no — snapshot ao fechar o cofre
ZTC_SNAPSHOT_DIR="$HOME/ztc-backup/snapshots"   # onde guardar as copias versionadas
ZTC_SNAPSHOT_KEEP="7"                            # quantas versoes manter (rotacao)

# Modo de abertura do KeePassXC: 'gui' (default) ou 'cli'.
# - gui: abre o KeePassXC graficamente; voce seleciona o keyfile no dialogo
#        na primeira vez (depois ele lembra). Recomendado para uso diario.
# - cli: abre keepassxc-cli interativo no terminal (sem GUI). Bom para
#        automacao, scripts ou maquinas headless.
# Por que nao usar 'keepassxc --keyfile X file.kdbx'? O flag --keyfile e
# IGNORADO pela GUI em 2.7.x — o banco abre sem keyfile e falha o unlock.
ZTC_KEEPASSXC_MODE="gui"
